GRAVIA_BOARD_MODE=demo
GRAVIA_BOARD_MAC=
GRAVIA_BOARD_SAMPLE_TIMEOUT=2
# On Raspberry/Linux add COMPOSE_FILE=docker-compose.yml:docker-compose.raspberry.yml
GRAVIA_PORT=8080
GRAVIA_DATABASE_URL=sqlite:////data/gravia.db
GRAVIA_MINIMUM_WEIGHT=20
GRAVIA_REQUIRED_STABILITY=95
GRAVIA_STABLE_DURATION=2.5
GRAVIA_SESSION_TIMEOUT=60
GRAVIA_DEMO_SEED=true
